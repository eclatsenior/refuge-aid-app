# Copia este archivo como android/keystore.properties y rellena tus datos.
# Genera el keystore con:
#   keytool -genkey -v -keystore refugi-release.jks -alias refugi -keyalg RSA -keysize 2048 -validity 10000
storeFile=../refugi-release.jks
storePassword=TU_PASSWORD
keyAlias=refugi
keyPassword=TU_PASSWORD

# Configuración de Supabase (requerido para funcionalidad completa)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Configuración de Sentry (opcional para crash reporting)
VITE_SENTRY_DSN=your-sentry-dsn

# Mensaje de alerta por defecto (editable por usuario)
VITE_DEFAULT_ALERT_MESSAGE="Necesito ayuda. Estoy en riesgo. Este es un aviso automático de Refugi."

# Configuración de desarrollo
NODE_ENV=development

# Para producción, cambiar a false
VITE_DEBUG=true